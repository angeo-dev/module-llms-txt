<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <!-- Dedicated group (see etc/cron_groups.xml): long generations no longer
         block default-group jobs. -->
    <group id="angeo_llms">
        <job name="angeo_llms_generate"
             instance="Angeo\LlmsTxt\Cron\GenerateLlmsFiles"
             method="execute">
            <config_path>angeo_llms/cron/schedule</config_path>
        </job>
    </group>
</config>
