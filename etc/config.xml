<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <angeo_llms>
            <general>
                <enabled>1</enabled>
                <exclude_store>0</exclude_store>
                <store_summary></store_summary>
                <!-- Attribution footer on markdown output (never JSONL).
                     Default on; merchants may disable it — see system.xml. -->
                <signature_enabled>1</signature_enabled>
            </general>
            <content>
                <include_categories>1</include_categories>
                <include_cms>1</include_cms>
                <include_products>1</include_products>
                <!-- llms.txt v2 removed the mechanical meaning of ## Optional;
                     products get their own section by default since 4.0.0. -->
                <products_under_optional>0</products_under_optional>
                <product_limit>5000</product_limit>
                <exclude_out_of_stock>0</exclude_out_of_stock>
                <cms_exclude_identifiers>no-route,enable-cookies,privacy-policy-cookie-restriction-mode</cms_exclude_identifiers>
                <customer_group_id>0</customer_group_id>
            </content>
            <formats>
                <generate_llms_txt>1</generate_llms_txt>
                <generate_llms_full_txt>0</generate_llms_full_txt>
                <generate_jsonl>1</generate_jsonl>
                <generate_agents_md>1</generate_agents_md>
                <generate_md_mirror>0</generate_md_mirror>
                <!-- llms.txt v2 (Aug 2026) discoverability + agentic sitemap. -->
                <emit_link_relations>1</emit_link_relations>
                <link_to_md>1</link_to_md>
                <generate_agentic_sitemap>1</generate_agentic_sitemap>
            </formats>
            <product_data>
                <export_attributes></export_attributes>
                <include_availability>1</include_availability>
                <include_image>1</include_image>
                <brand_attribute></brand_attribute>
                <stock_source>auto</stock_source>
            </product_data>
            <agents>
                <page_shipping></page_shipping>
                <page_returns></page_returns>
                <page_privacy></page_privacy>
                <page_terms></page_terms>
                <page_about></page_about>
                <support_url></support_url>
            </agents>
            <sanitizer>
                <resolve_directives>1</resolve_directives>
                <!-- SECURITY: default OFF — product content may originate from
                     semi-trusted import feeds; see system.xml field comment. -->
                <resolve_directives_products>0</resolve_directives_products>
                <page_builder_strategy>exclude</page_builder_strategy>
                <page_builder_excluded_types>products,banner,slider,slide,video,map,buttons,button-item,block,dynamic-block,divider,spacer</page_builder_excluded_types>
                <page_builder_allowed_types>text,heading,html,tabs,tab-item,row,column,column-group</page_builder_allowed_types>
            </sanitizer>
            <performance>
                <collection_page_size>500</collection_page_size>
                <!-- OFF by default: detection cannot see stock movements or
                     catalog price rules. Opt in knowingly. -->
                <skip_unchanged>0</skip_unchanged>
                <invalidate_mirror_on_save>1</invalidate_mirror_on_save>
            </performance>
            <http>
                <cache_ttl_seconds>3600</cache_ttl_seconds>
            </http>
            <cron>
                <schedule>0 2 * * *</schedule>
            </cron>
        </angeo_llms>
        <crontab>
            <default>
                <jobs>
                    <angeo_llms_generate>
                        <schedule>
                            <cron_expr>0 2 * * *</cron_expr>
                        </schedule>
                    </angeo_llms_generate>
                </jobs>
            </default>
        </crontab>
    </default>
</config>
