<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- ─── SPI bindings ─────────────────────────────────────────────── -->
    <preference for="Angeo\LlmsTxt\Api\SanitizerInterface"
                type="Angeo\LlmsTxt\Model\Sanitizer\Sanitizer"/>
    <preference for="Angeo\LlmsTxt\Api\UrlResolverInterface"
                type="Angeo\LlmsTxt\Model\Url\UrlResolver"/>
    <preference for="Angeo\LlmsTxt\Api\GenerationStatusRepositoryInterface"
                type="Angeo\LlmsTxt\Model\Repository\GenerationStatusRepository"/>
    <preference for="Angeo\LlmsTxt\Api\Data\GenerationStatusInterface"
                type="Angeo\LlmsTxt\Model\Data\GenerationStatus"/>

    <!-- ─── CLI commands ─────────────────────────────────────────────── -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="angeo_llms_generate" xsi:type="object">Angeo\LlmsTxt\Console\Command\GenerateCommand</item>
                <item name="angeo_llms_status"   xsi:type="object">Angeo\LlmsTxt\Console\Command\StatusCommand</item>
                <item name="angeo_llms_validate" xsi:type="object">Angeo\LlmsTxt\Console\Command\ValidateCommand</item>
            </argument>
        </arguments>
    </type>

    <!-- ─── Sanitizer pipeline ────────────────────────────────────────
         Run order matters:
           1. CMS directives must resolve BEFORE Page Builder filtering (some
              Page Builder blocks contain {{widget}} directives).
           2. Page Builder removal must run BEFORE strip_tags so we can use the
              data-content-type attribute to identify elements.
           3. HTML stripping last.
           4. Whitespace normalization at the end.
      ── -->
    <type name="Angeo\LlmsTxt\Model\Sanitizer\Sanitizer">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="cms_directive" xsi:type="object">Angeo\LlmsTxt\Model\Sanitizer\Filter\CmsDirectiveFilter</item>
                <item name="page_builder"  xsi:type="object">Angeo\LlmsTxt\Model\Sanitizer\Filter\PageBuilderFilter</item>
                <item name="html"          xsi:type="object">Angeo\LlmsTxt\Model\Sanitizer\Filter\HtmlFilter</item>
                <item name="whitespace"    xsi:type="object">Angeo\LlmsTxt\Model\Sanitizer\Filter\WhitespaceFilter</item>
            </argument>
        </arguments>
    </type>

    <!-- ─── LLMs.txt providers (markdown) ─────────────────────────────
         Order matters: StoreProvider MUST run first (emits the H1 + blockquote).
      ── -->
    <type name="Angeo\LlmsTxt\Model\Generator\LlmsTxtGenerator">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="store"    xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\StoreProvider</item>
                <item name="category" xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\CategoryProvider</item>
                <item name="cms"      xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\CmsPageProvider</item>
                <item name="product"  xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\ProductProvider</item>
            </argument>
            <!-- Explicit injection required: Magento's ObjectManager passes the
                 DEFAULT VALUE (null) for optional constructor params unless the
                 argument is configured here — optional params are never
                 auto-wired. Without these three lines the 3.3.0 signature falls
                 back to lazy instantiation and the 3.4.0 hub block silently
                 never renders. -->
            <argument name="signature" xsi:type="object">Angeo\LlmsTxt\Model\Output\Signature</argument>
            <argument name="surfacesBlock" xsi:type="object">Angeo\LlmsTxt\Model\Output\AgentSurfacesBlock</argument>
            <argument name="surfaceRegistry" xsi:type="object">Angeo\LlmsTxt\Model\Output\SurfaceRegistry</argument>
        </arguments>
    </type>

    <!-- ─── llms-full.txt providers ─── -->
    <type name="Angeo\LlmsTxt\Model\Generator\LlmsFullTxtGenerator">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="store"    xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\StoreProvider</item>
                <item name="category" xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\CategoryProvider</item>
                <item name="cms"      xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\CmsPageProvider</item>
                <item name="product"  xsi:type="object">Angeo\LlmsTxt\Model\Provider\Llms\ProductProvider</item>
            </argument>
        </arguments>
    </type>

    <!-- ─── JSONL providers ─── -->
    <type name="Angeo\LlmsTxt\Model\Generator\JsonlGenerator">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="store"    xsi:type="object">Angeo\LlmsTxt\Model\Provider\Jsonl\StoreProvider</item>
                <item name="category" xsi:type="object">Angeo\LlmsTxt\Model\Provider\Jsonl\CategoryProvider</item>
                <item name="cms"      xsi:type="object">Angeo\LlmsTxt\Model\Provider\Jsonl\CmsPageProvider</item>
                <item name="product"  xsi:type="object">Angeo\LlmsTxt\Model\Provider\Jsonl\ProductProvider</item>
            </argument>
        </arguments>
    </type>

    <!-- ─── Single-pass pipeline (3.2.0) ──────────────────────────────
         One catalog pass per store renders every enabled format.
         Entity providers stream format-agnostic records (order matters:
         store record first — it carries the H1/blockquote); renderers are
         keyed by the FORMAT_* code they serialize.
         The legacy generator/provider wiring above is DEPRECATED and will be
         removed in 4.0.0 together with generation_mode = legacy.
      ── -->
    <type name="Angeo\LlmsTxt\Model\Pipeline\SinglePassGenerator">
        <arguments>
            <argument name="entityProviders" xsi:type="array">
                <item name="store"    xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Provider\StoreEntityProvider</item>
                <item name="category" xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Provider\CategoryEntityProvider</item>
                <item name="cms"      xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Provider\CmsPageEntityProvider</item>
                <item name="product"  xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Provider\ProductEntityProvider</item>
            </argument>
            <argument name="renderers" xsi:type="array">
                <item name="llms_txt"      xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Renderer\LlmsTxtRenderer</item>
                <item name="llms_full_txt" xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Renderer\LlmsFullTxtRenderer</item>
                <item name="jsonl"         xsi:type="object">Angeo\LlmsTxt\Model\Pipeline\Renderer\JsonlRenderer</item>
            </argument>
            <!-- Explicit: optional params get their defaults (null) unless configured. -->
            <argument name="signature" xsi:type="object">Angeo\LlmsTxt\Model\Output\Signature</argument>
            <argument name="surfacesBlock" xsi:type="object">Angeo\LlmsTxt\Model\Output\AgentSurfacesBlock</argument>
            <argument name="surfaceRegistry" xsi:type="object">Angeo\LlmsTxt\Model\Output\SurfaceRegistry</argument>
        </arguments>
    </type>

    <!-- ─── agents.md generator hook (3.4.0) ───
         GenerationService's agentsMdGenerator param is optional for BC —
         which in Magento DI means it stays null unless injected here. -->
    <type name="Angeo\LlmsTxt\Service\GenerationService">
        <arguments>
            <argument name="agentsMdGenerator" xsi:type="object">Angeo\LlmsTxt\Model\Generator\AgentsMdGenerator</argument>
        </arguments>
    </type>
</config>
